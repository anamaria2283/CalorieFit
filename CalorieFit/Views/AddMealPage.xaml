<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.AddMealPage"
             Title="Adaugă Masă">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Image Source="dotnet_bot.png" HeightRequest="60" HorizontalOptions="Center" />
            <Label Text="Înregistrează un aliment" FontSize="18" FontAttributes="Bold" />

            <Label Text="Tipul Mesei:" />
            <Picker x:Name="MealTypePicker" Title="Selectează tipul mesei">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Mic Dejun</x:String>
                        <x:String>Prânz</x:String>
                        <x:String>Cină</x:String>
                        <x:String>Gustare</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Label Text="Denumire aliment:" />
            <Entry x:Name="FoodNameEntry" Placeholder="Ex: Piept de pui la grătar" />

            <Label Text="Calorii (kcal):" />
            <Entry x:Name="CaloriesEntry" Keyboard="Numeric" Placeholder="Ex: 250" />

            <Label x:Name="SliderLabel" Text="Proteine aproximative: 20 g" />
            <Slider x:Name="ProteinSlider" Minimum="0" Maximum="100" Value="20" ValueChanged="OnProteinSliderChanged" />

            <Button Text="Salvează în Jurnal" Clicked="OnSaveMealClicked" BackgroundColor="#2E7D32" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>