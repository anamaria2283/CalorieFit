<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CalorieFit.Models"
             x:Class="CalorieFit.Views.RecipeIdeasPage"
             Title="Idei de Rețete">
    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="15" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Image Source="healthy_meal.png" WidthRequest="30" HeightRequest="30" />
            <Label Text="Recomandări Nutriționale Sănătoase" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <SearchBar Grid.Row="1" x:Name="SearchBar" Placeholder="Caută o rețetă..." TextChanged="OnRecipeSearchChanged" />
        <Picker Grid.Row="2" x:Name="CategoryPicker" Title="Filtrează după categorie" SelectedIndexChanged="OnCategoryChanged">
            <Picker.Items>
                <x:String>Toate</x:String>
                <x:String>Mic Dejun</x:String>
                <x:String>Prânz</x:String>
                <x:String>Cină</x:String>
                <x:String>Gustare</x:String>
            </Picker.Items>
        </Picker>

        <CollectionView Grid.Row="3" x:Name="RecipesList" SelectionMode="Single" SelectionChanged="OnRecipeSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:MockRecipe">
                    <Border Stroke="#FB8C00" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,5">
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding ImageUrl}" WidthRequest="50" HeightRequest="50" Margin="0,0,10,0" />
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                <Label Text="{Binding Category, StringFormat='Categorie: {0}'}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Calories, StringFormat='Calorii: {0} kcal'}" TextColor="#E65100" />
                                <Label Text="{Binding CookingTime, StringFormat='Timp preparare: {0}'}" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>