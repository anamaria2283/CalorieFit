<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.MacroGoalsPage"
             Title="Obiective Nutrienți">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="dotnet_bot.png" HeightRequest="60" HorizontalOptions="Center" />
            <Label Text="Configurare Distribuție % Macronutrienți" FontSize="18" FontAttributes="Bold" />

            <Label x:Name="ProteinGoalLabel" Text="Proteine: 30%" />
            <Slider x:Name="ProteinGoalSlider" Minimum="10" Maximum="60" Value="30" ValueChanged="OnSliderChanged" />

            <Label x:Name="CarbGoalLabel" Text="Carbohidrați: 40%" />
            <Slider x:Name="CarbGoalSlider" Minimum="10" Maximum="70" Value="40" ValueChanged="OnSliderChanged" />

            <Label x:Name="FatGoalLabel" Text="Grăsimi: 30%" />
            <Slider x:Name="FatGoalSlider" Minimum="10" Maximum="50" Value="30" ValueChanged="OnSliderChanged" />

            <HorizontalStackLayout Spacing="10">
                <Label Text="Permite auto-echilibrare:" VerticalOptions="Center" />
                <Switch IsToggled="True" />
            </HorizontalStackLayout>

            <ProgressBar Progress="1.0" ProgressColor="#00897B" />
            <Button Text="Aplică Obiective" Clicked="OnApplyGoalsClicked" BackgroundColor="#00897B" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>