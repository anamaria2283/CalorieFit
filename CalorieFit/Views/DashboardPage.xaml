<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.DashboardPage"
             Title="CalorieFit - Panou Principal">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="dotnet_bot.png" HeightRequest="90" HorizontalOptions="Center" />
            <Label x:Name="WelcomeLabel" Text="Bine ai venit!" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />

            <Border Stroke="#4CAF50" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progres Calorii Astăzi" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="CalorieRatioLabel" Text="0 / 2000 kcal" />
                    <ProgressBar x:Name="CalorieProgressBar" Progress="0.0" ProgressColor="#4CAF50" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#2196F3" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Hidratare Astăzi" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="WaterRatioLabel" Text="0 / 2500 ml" />
                    <ProgressBar x:Name="WaterProgressBar" Progress="0.0" ProgressColor="#2196F3" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Reîmprospătează datele" Clicked="OnRefreshClicked" BackgroundColor="#2E7D32" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>