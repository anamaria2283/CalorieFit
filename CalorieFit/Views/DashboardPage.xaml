<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.DashboardPage"
             Title="CalorieFit - Panou Principal">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="healthy_meal.png" HeightRequest="90" HorizontalOptions="Center" />
            <Label x:Name="WelcomeLabel" Text="Bine ai venit!" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" />

            <Border Stroke="#4CAF50" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Progres Calorii Astăzi" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="CalorieRatioLabel" Text="0 / 2000 kcal" />
                    <ProgressBar x:Name="CalorieProgressBar" Progress="0.0" ProgressColor="#4CAF50" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#00897B" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Obiectivele tale de azi" FontAttributes="Bold" FontSize="17" />
                    <Label x:Name="MacroProgressSummaryLabel" Text="Completează obiectivele din pagina Obiective Macronutrienți." TextColor="#455A64" />

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="ProteinProgressLabel" Text="Proteine: 0 / 120 g" />
                        <ProgressBar x:Name="ProteinProgressBar" Progress="0" ProgressColor="#E53935" HeightRequest="12" />
                        <Label x:Name="ProteinProgressMessage" Text="" FontSize="12" TextColor="#546E7A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="CarbsProgressLabel" Text="Carbohidrați: 0 / 250 g" />
                        <ProgressBar x:Name="CarbsProgressBar" Progress="0" ProgressColor="#E53935" HeightRequest="12" />
                        <Label x:Name="CarbsProgressMessage" Text="" FontSize="12" TextColor="#546E7A" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="FatProgressLabel" Text="Grăsimi: 0 / 70 g" />
                        <ProgressBar x:Name="FatProgressBar" Progress="0" ProgressColor="#E53935" HeightRequest="12" />
                        <Label x:Name="FatProgressMessage" Text="" FontSize="12" TextColor="#546E7A" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#2196F3" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Hidratare Astăzi" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="WaterRatioLabel" Text="0 / 2500 ml" />
                    <ProgressBar x:Name="WaterProgressBar" Progress="0.0" ProgressColor="#2196F3" />
                </VerticalStackLayout>
            </Border>

            <Border Stroke="#FFB300" StrokeShape="RoundRectangle 12" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Jurnalul zilei" FontAttributes="Bold" FontSize="16" />
                    <Label x:Name="DailyReflectionSummaryLabel" Text="Încă nu ai notat ziua de azi." />
                    <Button x:Name="DailyReflectionToggleButton" Text="Adaugă o notă despre ziua ta" Clicked="OnToggleDailyReflectionClicked" BackgroundColor="#2E7D32" TextColor="White" />
                    <VerticalStackLayout x:Name="DailyReflectionEditor" IsVisible="False" Spacing="10">
                        <Label Text="Cum ți-a fost ziua? Alege un scor de la 1 la 5:" />
                        <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5">
                            <Button x:Name="Rating1Button" Grid.Column="0" Text="😞 1" CommandParameter="1" Clicked="OnRatingSelected" />
                            <Button x:Name="Rating2Button" Grid.Column="1" Text="🙁 2" CommandParameter="2" Clicked="OnRatingSelected" />
                            <Button x:Name="Rating3Button" Grid.Column="2" Text="😐 3" CommandParameter="3" Clicked="OnRatingSelected" />
                            <Button x:Name="Rating4Button" Grid.Column="3" Text="🙂 4" CommandParameter="4" Clicked="OnRatingSelected" />
                            <Button x:Name="Rating5Button" Grid.Column="4" Text="😄 5" CommandParameter="5" Clicked="OnRatingSelected" />
                        </Grid>
                        <Editor x:Name="DailyReflectionNotesEditor" Placeholder="Scrie câteva note despre ziua ta..." AutoSize="TextChanges" />
                        <Button Text="Salvează nota" Clicked="OnSaveDailyReflectionClicked" BackgroundColor="#2E7D32" TextColor="White" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>