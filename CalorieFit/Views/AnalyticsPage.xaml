<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.AnalyticsPage"
             Title="Reprezentare Grafică">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Image Source="healthy_meal.png" WidthRequest="30" HeightRequest="30" />
                <Label Text="Analiză nutrițională" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Border Stroke="#B0BEC5" StrokeShape="RoundRectangle 10" Padding="12">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="Analizează ziua:" FontAttributes="Bold" VerticalOptions="Center" />
                    <DatePicker x:Name="AnalysisDatePicker" DateSelected="OnAnalysisDateSelected" />
                </HorizontalStackLayout>
            </Border>

            <Label x:Name="SelectedDateLabel" Text="Totaluri pentru ziua selectată" FontSize="17" FontAttributes="Bold" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                <Border Grid.Column="0" Stroke="#B0BEC5" StrokeShape="RoundRectangle 10" Padding="8">
                    <GraphicsView x:Name="MacroPieChart" HeightRequest="250" WidthRequest="250" />
                </Border>
                <Border Grid.Column="1" Stroke="#B0BEC5" StrokeShape="RoundRectangle 10" Padding="15">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="10">
                        <Label Text="Total consumat" FontAttributes="Bold" FontSize="16" />
                        <Label x:Name="CaloriesTotalLabel" Text="0 kcal" FontSize="20" TextColor="#E65100" />
                        <Label x:Name="ProteinTotalLabel" Text="Proteine: 0 g" TextColor="#43A047" />
                        <Label x:Name="CarbsTotalLabel" Text="Carbohidrați: 0 g" TextColor="#FB8C00" />
                        <Label x:Name="FatTotalLabel" Text="Grăsimi: 0 g" TextColor="#D81B60" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Evoluția proteinelor - ultimele 7 zile" FontSize="17" FontAttributes="Bold" />
            <Border Stroke="#B0BEC5" StrokeShape="RoundRectangle 10" Padding="10">
                <GraphicsView x:Name="ProteinTrendChart" HeightRequest="230" />
            </Border>

            <Label x:Name="NoDataLabel" Text="" TextColor="#616161" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>