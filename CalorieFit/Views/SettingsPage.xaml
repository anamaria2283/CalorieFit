<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.SettingsPage"
             Title="Setări Aplicație">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="dotnet_bot.png" HeightRequest="60" HorizontalOptions="Center" />
            <Label Text="Setări Generale &amp; Mentenanță" FontSize="18" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="15">
                <Label Text="Mod Întunecat (Dark Mode):" VerticalOptions="Center" />
                <Switch x:Name="DarkModeSwitch" Toggled="OnDarkModeToggled" />
            </HorizontalStackLayout>

            <Label Text="Dimensiune text interfață:" />
            <Slider Minimum="12" Maximum="24" Value="16" />

            <Label Text="Server API backup:" />
            <Entry Text="https://api.caloriefit-local.internal/v1" />

            <Button Text="Curățare Date Locale SQLite" Clicked="OnClearDataClicked" BackgroundColor="#C62828" TextColor="White" />
            <Button Text="Despre CalorieFit (Echipa 15)" Clicked="OnAboutClicked" BackgroundColor="#455A64" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>