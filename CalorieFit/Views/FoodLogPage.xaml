<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:CalorieFit.Models"
             x:Class="CalorieFit.Views.FoodLogPage"
             Title="Jurnal Alimentar">
    <Grid RowDefinitions="Auto, Auto, *" Padding="15" RowSpacing="10">
        <HorizontalStackLayout Grid.Row="0" Spacing="10">
            <Image Source="dotnet_bot.png" WidthRequest="30" HeightRequest="30" />
            <DatePicker x:Name="LogDatePicker" DateSelected="OnDateSelected" />
            <Button x:Name="SortCaloriesButton" Text="Sortează kcal ↓" Clicked="OnSortCaloriesClicked" />
        </HorizontalStackLayout>

        <Label Grid.Row="1" x:Name="SummaryLabel" Text="Total calorii: 0 kcal" FontAttributes="Bold" />

        <CollectionView Grid.Row="2" x:Name="FoodCollectionView" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nu există alimente înregistrate pentru această dată." HorizontalTextAlignment="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:FoodEntry">
                    <Border Stroke="#BDBDBD" StrokeShape="RoundRectangle 8" Padding="10" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding FoodName}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding MealType}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Calories, StringFormat='{0:F0} kcal'}" TextColor="#E65100" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Șterge" Clicked="OnDeleteEntryClicked" CommandParameter="{Binding .}" BackgroundColor="#D32F2F" TextColor="White" HeightRequest="40" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>