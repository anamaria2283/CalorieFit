<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieFit.Views.WaterTrackerPage"
             Title="Monitorizare Apă">
    <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">
        <Image Source="healthy_meal.png" HeightRequest="80" HorizontalOptions="Center" />
        <Label x:Name="WaterStatusLabel" Text="Apă băută azi: 0 ml / 2500 ml" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />

        <ProgressBar x:Name="WaterBar" Progress="0.0" ProgressColor="#1E88E5" HeightRequest="15" />

        <Label x:Name="StepperLabel" Text="Porție selectată: 250 ml" HorizontalTextAlignment="Center" />
        <Stepper x:Name="GlassStepper" Minimum="100" Maximum="1000" Increment="50" Value="250" HorizontalOptions="Center" ValueChanged="OnStepperValueChanged" />

        <Button Text="Adaugă porția de apă" Clicked="OnAddWaterClicked" BackgroundColor="#1E88E5" TextColor="White" />

        <Button Text="Resetează ziua" Clicked="OnResetWaterClicked" BackgroundColor="#E53935" TextColor="White" />
    </VerticalStackLayout>
</ContentPage>